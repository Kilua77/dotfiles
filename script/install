#!/usr/bin/env bash
#
# install — run the package managers and every topic's install.sh.
#
#   1. brew bundle on the root Brewfile (brew itself is the OS guard — it is
#      simply absent on Linux), hash-gated so an unchanged Brewfile is a no-op
#   2. every */install.sh in deterministic (alphabetical) topic order; a
#      failing installer logs a WARN and does not stop the others
#
# The run is narrated: the topic plan is printed up front, and a SUMMARY with
# per-topic status (plus NEXT STEPS when something failed) closes it.
#
# Idempotent: safe to run as often as you like (that is what bin/dot does).

set -euo pipefail

DOTFILES_ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
# shellcheck source=/dev/null  # gate.sh is linted on its own
. "$DOTFILES_ROOT/script/gate.sh"

status_topic=()  # parallel arrays: topic name -> ok / skipped / FAILED
status_state=()

record() {  # record <topic> <state>
  status_topic+=("$1")
  status_state+=("$2")
}

# 1. Homebrew packages (macOS; the `brew` command is the guard).
if command -v brew >/dev/null 2>&1 && [ -f "$DOTFILES_ROOT/Brewfile" ]; then
  echo '==> Brewfile'
  if gate brew "$DOTFILES_ROOT/Brewfile"; then
    if brew bundle --file="$DOTFILES_ROOT/Brewfile"; then
      gate_done brew "$DOTFILES_ROOT/Brewfile"
      record brew ok
    else
      echo 'WARN: brew bundle failed (continuing)'
      record brew FAILED
    fi
  else
    echo '==> Brewfile (unchanged, skipped)'
    record brew skipped
  fi
fi

# 2. Topic installers, alphabetical topic order.
installers=()
while IFS= read -r installer; do
  installers+=("$installer")
done < <(find "$DOTFILES_ROOT" -mindepth 2 -maxdepth 2 -name install.sh \
           -not -path '*/.git/*' | sort)

# Plan up front, so the user knows what is about to run and how far along it is.
plan=""
for installer in "${installers[@]}"; do
  plan="$plan$(basename "$(dirname "$installer")") "
done
echo "install: ${#installers[@]} topic installer(s):${plan% }"

log="$(mktemp)"
trap 'rm -f "$log"' EXIT

for installer in "${installers[@]}"; do
  topic="$(basename "$(dirname "$installer")")"
  echo "==> ${installer#"$DOTFILES_ROOT"/}"
  # tee keeps the installer's output live while keeping a copy so internal
  # WARN lines can be counted for the summary (an installer that exits 0
  # with warnings is "ok (n warn)", not a plain "ok").
  warns=0
  if (cd "$(dirname "$installer")" && ./install.sh) 2>&1 | tee "$log"; then
    warns="$(grep -c '^WARN' "$log" || true)"
    if [ "${warns:-0}" -gt 0 ]; then
      record "$topic" "ok ($warns warn)"
    else
      record "$topic" ok
    fi
  else
    echo "WARN: $installer failed (continuing)"
    record "$topic" FAILED
  fi
done

# --- SUMMARY -------------------------------------------------------------------
echo
echo 'install: SUMMARY'
failures=0
failed_topics=""
for i in "${!status_topic[@]}"; do
  printf 'install:   %-9s %s\n' "${status_topic[$i]}" "${status_state[$i]}"
  if [ "${status_state[$i]}" = FAILED ]; then
    failures=$((failures + 1))
    failed_topics="$failed_topics ${status_topic[$i]}"
  fi
done

if [ "$failures" -gt 0 ]; then
  echo 'install: NEXT STEPS'
  echo 'install:   re-run ~/.dotfiles/script/install — idempotent, failures retry'
  case "$failed_topics" in
    *apt*)
      echo 'install:   apt failed: if sudo asked for a password, re-run from an'
      echo 'install:   interactive terminal (the script cannot answer prompts)'
      ;;
  esac
fi

exit 0

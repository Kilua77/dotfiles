#!/usr/bin/env bash
#
# cpp-new — scaffold a house-style C++20 project.
#
# Usage: cpp-new <name> [--vcpkg] [dir]
#
#   name      project name: letters, digits, '-', '_'; must start with a
#             letter or '_'
#   --vcpkg   also write vcpkg.json and CMakeUserPresets.json.example
#   dir       parent directory to create the project in (default: current)
#
# The generated project follows the house doctrine: C++20 with no compiler
# extensions, warnings as errors, tests always (doctest), sanitizer presets
# one step away, ccache used transparently when installed.
#
# Placeholders __NAME__ / __VCPKG_NAME__ are substituted after writing, so
# every heredoc below can stay quoted (literal ${...} in presets survives).
set -euo pipefail

prog=cpp-new

usage() {
    cat <<'EOF'
Usage: cpp-new <name> [--vcpkg] [dir]

  name     project name (letters, digits, '-', '_'; no leading digit)
  --vcpkg  also generate vcpkg.json and CMakeUserPresets.json.example
  dir      parent directory to create the project in (default: current)
EOF
}

die() { printf '%s: error: %s\n' "$prog" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# Rewrite placeholders in the given files. sed to a temp file + mv keeps it
# portable across GNU and BSD/macOS sed (no sed -i flag differences).
subst() {
    for f in "$@"; do
        sed -e "s/__NAME__/$name/g" -e "s/__VCPKG_NAME__/$vcpkg_name/g" \
            "$f" > "$f.tmp" && mv "$f.tmp" "$f"
    done
}

# ---- Parse and validate arguments -----------------------------------------

name='' parent='' use_vcpkg=0
while [ $# -gt 0 ]; do
    case $1 in
        --vcpkg) use_vcpkg=1 ;;
        -h|--help) usage; exit 0 ;;
        -*) die "unknown option '$1'" ;;
        *)
            if [ -z "$name" ]; then name=$1
            elif [ -z "$parent" ]; then parent=$1
            else die "unexpected extra argument '$1'"
            fi
            ;;
    esac
    shift
done

[ -n "$name" ] || { usage >&2; die "missing project name"; }
case $name in
    [!A-Za-z_]*) die "name must start with a letter or '_' (got '$name')" ;;
    *[!A-Za-z0-9_-]*) die "name may contain only letters, digits, '-' and '_' (got '$name')" ;;
esac

# vcpkg manifest names are lowercase, digits and hyphens only.
vcpkg_name=''
[ "$use_vcpkg" -eq 1 ] && vcpkg_name=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | tr '_' '-')

# ---- Guard, then lay out the target directory ------------------------------

parent=${parent:-.}
[ "$parent" = "." ] && parent=$PWD
target=$parent/$name

# Refuse to scaffold into an existing non-empty directory.
if [ -d "$target" ]; then
    [ -z "$(ls -A "$target")" ] || die "'$target' already exists and is not empty"
elif [ -e "$target" ]; then
    die "'$target' exists and is not a directory"
fi
mkdir -p "$target/src" "$target/tests"

# ---- Project files ---------------------------------------------------------

cat > "$target/CMakeLists.txt" <<'EOF'
# Generated by cpp-new (house dotfiles).
# 3.30 floor: matches presets v6 features used here. If your CMake is older
# (check: cmake --version), lowering to 3.28 still works for this template.
cmake_minimum_required(VERSION 3.30)

project(__NAME__ LANGUAGES CXX)

# C++20, strict: REQUIRED fails instead of silently degrading, and no
# compiler extensions (no GNU-dialect surprises when switching compilers).
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# House warning set as an INTERFACE target: link it into every target
# instead of scattering add_compile_options around. Warnings are errors.
add_library(__NAME___warnings INTERFACE)
target_compile_options(__NAME___warnings INTERFACE
    $<$<CXX_COMPILER_ID:MSVC>:/W4 /WX>
    $<$<NOT:$<CXX_COMPILER_ID:MSVC>>:-Wall -Wextra -Wpedantic -Werror -Wshadow -Wconversion>
)

add_executable(__NAME__ src/main.cpp)
target_link_libraries(__NAME__ PRIVATE __NAME___warnings)

# Tests are not optional (house doctrine).
enable_testing()
add_subdirectory(tests)
EOF

cat > "$target/src/main.cpp" <<'EOF'
// Entry point — intentionally minimal; grow it as the project grows.
int main() {
    return 0;
}
EOF

cat > "$target/tests/CMakeLists.txt" <<'EOF'
# Test suite: doctest, fetched once per build directory (pinned tag), then
# cached — ccache (see CMakePresets.json) makes rebuilds near-instant.
include(FetchContent)

FetchContent_Declare(
    doctest
    GIT_REPOSITORY https://github.com/doctest/doctest.git
    GIT_TAG        v2.4.12
    GIT_SHALLOW    TRUE
)
FetchContent_MakeAvailable(doctest)

add_executable(__NAME___tests test___NAME__.cpp)
target_link_libraries(__NAME___tests PRIVATE
    __NAME___warnings
    doctest::doctest
)

# Register with ctest: `ctest --preset <preset>` runs it.
add_test(NAME __NAME___tests COMMAND __NAME___tests)
EOF

# Written directly under its final (already-substituted) name; the content
# below carries no placeholders.
cat > "$target/tests/test_${name}.cpp" <<'EOF'
// DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN makes doctest provide main() here —
// no test-runner boilerplate needed. Start with one smoke test proving the
// harness builds and runs, then add real cases.
#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
#include <doctest/doctest.h>

TEST_CASE("the test harness runs") {
    CHECK(1 + 1 == 2);
}
EOF

# Strict JSON: no comments inside. The description fields carry the notes
# (and are displayed by `cmake --list-presets`), keeping the file loadable
# by any JSON tool.
cat > "$target/CMakePresets.json" <<'EOF'
{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "debug",
      "description": "Debug build. Exports compile_commands.json for clangd. The compiler is launched through ccache; if ccache is not installed, clear CMAKE_CXX_COMPILER_LAUNCHER here.",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "release",
      "description": "Optimized build. Same setup as debug: compile_commands.json exported, ccache used as launcher if installed.",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "asan",
      "description": "Sanitizers one preset away: Debug build with AddressSanitizer + UndefinedBehaviorSanitizer and frame pointers kept for stack traces. GCC/Clang flags; on MSVC use /fsanitize=address instead.",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } }
  ]
}
EOF

cat > "$target/.clang-format" <<'EOF'
# House C++ formatting style lives in ~/.clang-format (deployed from the
# dotfiles). InheritParentConfig makes this project follow the config found
# in a parent directory — i.e. the house style, since checkouts live under
# $HOME. Project-specific overrides go below this comment.
---
BasedOnStyle: InheritParentConfig
EOF

cat > "$target/.gitignore" <<'EOF'
build/
compile_commands.json
EOF

cat > "$target/README.md" <<'EOF'
# __NAME__

C++20 project generated by `cpp-new` from the house dotfiles.

## Build and test

    cmake --preset debug            # configure (creates build/debug)
    cmake --build --preset debug    # compile
    ctest --preset debug            # run the doctest suite

Other presets: `release` (optimized) and `asan` (Debug + AddressSanitizer
and UndefinedBehaviorSanitizer) — same three commands with the name swapped.

## Editor setup

Each configure exports `build/<preset>/compile_commands.json` for clangd.
Symlink it to the project root once:

    ln -s build/debug/compile_commands.json .

Formatting and linting inherit the house style from `~/.clang-format` and
`~/.clang-tidy` (see this project's `.clang-format`).

Presets launch the compiler through ccache. Without ccache installed,
configure still works — clear `CMAKE_CXX_COMPILER_LAUNCHER` in the preset.

## Dependencies with vcpkg

Add entries to the `dependencies` array in `vcpkg.json`, then:

    cp CMakeUserPresets.json.example CMakeUserPresets.json  # once; needs VCPKG_ROOT
    cmake --preset vcpkg && cmake --build --preset vcpkg && ctest --preset vcpkg
EOF

if [ "$use_vcpkg" -eq 1 ]; then
    cat > "$target/vcpkg.json" <<'EOF'
{
  "name": "__VCPKG_NAME__",
  "version-string": "0.1.0",
  "dependencies": []
}
EOF

    # An example (never parsed by CMake), so explanatory comments are fine.
    cat > "$target/CMakeUserPresets.json.example" <<'EOF'
// Copy to CMakeUserPresets.json to resolve dependencies through vcpkg.
// CMakeUserPresets.json is the personal/machine layer merged on top of
// CMakePresets.json — the documented home for a local vcpkg toolchain, so
// the shared presets stay toolchain-agnostic. Requires VCPKG_ROOT to point
// at a vcpkg checkout (the presets below reference it via $env{VCPKG_ROOT}).
{
  "version": 6,
  "configurePresets": [
    {
      "name": "vcpkg",
      "description": "Debug build resolving dependencies declared in vcpkg.json via the vcpkg toolchain.",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ],
  "buildPresets": [
    { "name": "vcpkg", "configurePreset": "vcpkg" }
  ],
  "testPresets": [
    { "name": "vcpkg", "configurePreset": "vcpkg", "output": { "outputOnFailure": true } }
  ]
}
EOF
fi

subst "$target/CMakeLists.txt" "$target/tests/CMakeLists.txt" "$target/README.md"
[ "$use_vcpkg" -eq 1 ] && subst "$target/vcpkg.json"

# A git repository is started if git exists; the first commit is left to
# the author.
if have git; then
    git -C "$target" init -q
fi

# ---- Report ----------------------------------------------------------------

printf 'Created project in %s\n\n' "$target"
printf 'Next steps:\n'
printf '  cd %s\n' "$target"
printf '  cmake --preset debug && cmake --build --preset debug\n'
printf '  ctest --preset debug\n'
if [ "$use_vcpkg" -eq 1 ]; then
    printf '\nvcpkg: export VCPKG_ROOT, then copy CMakeUserPresets.json.example\n'
    printf 'to CMakeUserPresets.json and add dependencies in vcpkg.json.\n'
fi
have git || printf '\nNote: git not found — run "git init" when available.\n'
have cmake || printf '\nNote: cmake not found on PATH — install CMake >= 3.28 to build.\n'

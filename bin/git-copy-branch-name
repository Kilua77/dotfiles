#!/bin/sh
# git-copy-branch-name — print the current git branch and copy it to the
# clipboard. Clipboard tools are tried in order: pbcopy (macOS),
# clip.exe (WSL), xclip, xsel; as a last resort an OSC52 escape sequence
# lets the terminal itself copy the text (also works over SSH).

branch=$(git branch --show-current 2>/dev/null)
if [ -z "$branch" ]; then
    echo "git-copy-branch-name: not inside a git branch (detached HEAD?)" >&2
    exit 1
fi
printf '%s\n' "$branch"

if command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$branch" | pbcopy
elif command -v clip.exe >/dev/null 2>&1; then
    printf '%s' "$branch" | clip.exe
elif command -v xclip >/dev/null 2>&1; then
    printf '%s' "$branch" | xclip -selection clipboard
elif command -v xsel >/dev/null 2>&1; then
    printf '%s' "$branch" | xsel --clipboard --input
else
    # OSC52: the terminal stores the base64 payload in its clipboard.
    printf '\033]52;c;%s\a' "$(printf '%s' "$branch" | base64)"
fi

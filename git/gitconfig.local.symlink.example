# ~/.gitconfig.local — machine-local git configuration.
#
# Generated by script/bootstrap on first run: it asks for your name and
# email, substitutes the three placeholder tokens below, then chmods to 600.
# After generation this file is yours: edit it freely, bootstrap never
# overwrites an existing one. ~/.gitconfig includes it, so anything here
# overrides the repo defaults on this machine only.

[user]
    name = AUTHORNAME
    email = AUTHOREMAIL

# Credentials: bootstrap fills in osxkeychain on macOS, cache on Linux.
[credential]
    helper = GIT_CREDENTIAL_HELPER
    # Better on desktop Linux (GNOME Keyring / KWallet via libsecret):
    #   sudo apt-get install libsecret-1-0 libsecret-1-dev
    #   sudo make -C /usr/share/doc/git/contrib/credential/libsecret
    # then replace the helper line with:
    #   helper = /usr/share/doc/git/contrib/credential/libsecret/git-credential-libsecret

# --- Examples — uncomment and adjust as needed ------------------------------

# A second identity for this machine (e.g. work):
# [user]
#     name = Work Name
#     email = work@example.com
# (For a per-directory split instead of machine-wide, use conditional
# includes pointing at another local file:)
# [includeIf "gitdir:~/work/"]
#     path = ~/.gitconfig-work

# Machine-specific tweaks:
# [core]
#     editor = vim

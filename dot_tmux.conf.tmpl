{{/* vim: set filetype=go: */}}
{{/*
  ~/.tmux.conf — managed by chezmoi (edit the source, not the target).

  Ported from a legacy 2016 config, modernized:
  - copy-mode-vi table (the old `bind -t vi-copy` syntax was removed in tmux 2.4)
  - `copy-command` (tmux >= 3.2) instead of hardcoded copy-pipe targets
  - true color + tmux-256color
  - no hardcoded absolute paths

  Clipboard strategy (the one place where the environment matters):
  - darwin : pbcopy, chosen at render time
  - linux  : decided at RUNTIME via if-shell (clip.exe under Windows
            interoperability, else xclip/xsel) — no environment detection
            in the template itself.
  Requires tmux >= 3.2 (brew and Ubuntu 24.04 both ship newer).
*/}}
{{- if eq .chezmoi.os "darwin" }}
set -g copy-command "pbcopy"
{{- else }}
if-shell 'command -v clip.exe >/dev/null 2>&1' \
    'set -g copy-command "clip.exe"' \
    'set -g copy-command "xclip -in -selection clipboard"'
{{- end }}

# ── Terminal ─────────────────────────────────────────────────────────────────
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",xterm-256color:Tc"

# ── Core options ─────────────────────────────────────────────────────────────
unbind C-b
set -g prefix C-a
bind C-a last-window
bind a send-prefix

set -g base-index 1
set -g renumber-windows on
set -g mouse on
set -g history-limit 102400
set -g repeat-time 500
set -g status-keys emacs
set -g escape-time 10

setw -g mode-keys vi

# ── Windows and panes ────────────────────────────────────────────────────────
# New splits always inherit the current pane's working directory.
bind c new-window -c "#{pane_current_path}"
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"

bind -r > swap-window -t :+
bind -r < swap-window -t :-
bind BSpace previous-window
bind Space next-window

bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R
bind Tab select-pane -t :.+
bind BTab select-pane -t :.-

bind -r H resize-pane -L 10
bind -r J resize-pane -D 10
bind -r K resize-pane -U 10
bind -r L resize-pane -R 10

# Reload this file.
bind R source-file ~/.tmux.conf \; display-message "Reloaded!"

# ── Copy mode (vi) ───────────────────────────────────────────────────────────
unbind [
bind Escape copy-mode
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi y send -X copy-pipe-and-cancel

{{- if eq .chezmoi.os "linux" }}
# Paste: prefer the Windows clipboard when the interop binary exists
# (runtime guard — no-op elsewhere), else the normal tmux buffer.
bind p run-shell 'if command -v powershell.exe >/dev/null 2>&1; then tmux set-buffer "$(powershell.exe -NoProfile Get-Clipboard | tr -d "\r")"; fi; tmux paste-buffer'
{{- end }}

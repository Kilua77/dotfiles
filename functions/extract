# extract <archive> — universal archive extractor.
# Loaded on first call via the autoload in functions/fpath.zsh.
# Note: case matches the FIRST matching pattern, so compound suffixes
# (e.g. *.pax.Z, *.tar.bz2) must be listed before their shorter forms.

if [[ -z "$1" ]]; then
    echo "usage: extract <archive>" >&2
    return 1
fi
if [[ ! -f "$1" ]]; then
    echo "extract: no such file: $1" >&2
    return 1
fi

case "$1" in
    # tar family (same flags cover bz2/gz members).
    *.tar.bz2|*.tbz2)   tar -xvf "$1" ;;
    *.tar.gz|*.tgz)     tar -xvf "$1" ;;
    *.tar)              tar -xvf "$1" ;;
    # single-file compressors.
    *.bz2)              bunzip2 "$1" ;;
    *.gz)               gunzip "$1" ;;
    *.zip|*.ZIP)        unzip "$1" ;;
    *.rar)              unrar x "$1" ;;
    *.7z)               7z x "$1" ;;
    # legacy pax archives — *.pax.Z before *.pax and *.Z (see note above).
    *.pax.Z)            uncompress "$1" | pax -r ;;
    *.pax)              pax -r -f "$1" ;;
    *.Z)                uncompress "$1" ;;
    # darwin only: mount the disk image rather than unpack it.
    *.dmg)              hdiutil mount "$1" ;;
    *)                  echo "extract: unknown archive type: $1" >&2; return 1 ;;
esac
